{
  "name": "brvm-live",
  "version": "2.0.0",
  "description": "API et interface des cours BRVM (scraping du site officiel brvm.org), prête pour un VPS",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "lint": "eslint .",
    "hash-password": "node scripts/hash-password.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@ip-location-db/dbip-country-mmdb": "^2.3.2026060120",
    "bowser": "^2.15.0",
    "cheerio": "^1.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "maxmind": "^5.0.8",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  }
}
