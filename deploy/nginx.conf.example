# Exemple de reverse proxy Nginx pour BRVM Live.
# Adapter le domaine, les chemins de certificats et l'emplacement des snippets TLS.
# Certificats : certbot --nginx -d brvm.example.com

upstream brvm_live {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name brvm.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name brvm.example.com;

    ssl_certificate     /etc/letsencrypt/live/brvm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brvm.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size 16k;
    server_tokens off;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    location = /health {
        access_log off;
        proxy_pass http://brvm_live;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://brvm_live;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }
}
