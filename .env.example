# Environnement d'exemple - copier vers .env puis remplir les secrets.
# Ne jamais committer .env.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# URL publique du site, sans / final (URL canoniques, sitemap.xml, balises de partage).
# PUBLIC_URL=https://brvm.example.com

# Requis en production (32 caractères minimum).
# Générer avec : openssl rand -hex 32
SESSION_SECRET=

# Administration (http://votre-domaine/admin)
# Générer le hash avec : printf '%s' 'mot-de-passe' | npm run hash-password
# (sans Node sur l'hôte : voir README, section « Configurer l'application »).
# IMPORTANT : gardez les apostrophes, sinon Docker Compose interprète les $ du hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''

# Clés API optionnelles, séparées par des virgules.
# Générer avec : openssl rand -hex 24
# Si API_KEYS_REQUIRED=true, /api/* exige X-API-Key ou Authorization: Bearer <clé>.
API_KEYS=
API_KEYS_REQUIRED=false

# Origines autorisées pour CORS (vide = *). Exemple :
# ALLOWED_ORIGINS=https://brvm.example.com
ALLOWED_ORIGINS=

# Nombre de reverse proxies de confiance devant l'application (Nginx = 1).
TRUST_PROXY=1

# Scraping et cache
SOURCE_URL=https://www.brvm.org/fr/cours-actions/0
CACHE_TTL_MS=1800000
CACHE_MAX_STALE_MS=86400000
SCRAPE_TIMEOUT_MS=10000
SCRAPE_RETRIES=2
# Délai avant de retenter brvm.org après un échec (les visiteurs reçoivent le cache de secours).
SCRAPE_FAILURE_COOLDOWN_MS=60000

# Fréquentation (aucune IP brute n'est stockée)
VISITS_RETENTION_DAYS=90

# Durée des sessions (admin : 8 h, comptes utilisateurs : 7 jours)
# SESSION_TTL_MS=28800000
# USER_SESSION_TTL_MS=604800000

# Limites de débit (fenêtre par défaut : 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_API=60
# RATE_LIMIT_API_KEY=600
# RATE_LIMIT_VISITS=120
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_ADMIN=240
# RATE_LIMIT_SIGNUP=5        # inscriptions réussies par IP
# RATE_LIMIT_USER_LOGIN=15   # échecs de connexion utilisateur par IP
# RATE_LIMIT_ACCOUNT=120     # requêtes compte / favoris par IP
