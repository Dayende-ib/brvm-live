# Environnement d'exemple — copier vers .env puis remplir les secrets.
# Ne jamais committer .env.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Requis en production (32 caractères minimum).
# Générer avec : openssl rand -hex 32
SESSION_SECRET=

# Administration (http://votre-domaine/admin)
# Générer le hash avec : printf '%s' 'mot-de-passe' | npm run hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Clés API optionnelles, séparées par des virgules.
# Générer avec : openssl rand -hex 24
# Si API_KEYS_REQUIRED=true, /api/* exige X-API-Key ou Authorization: Bearer <clé>.
API_KEYS=
API_KEYS_REQUIRED=false

# Origines autorisées pour CORS (vide = *). Exemple :
# ALLOWED_ORIGINS=https://brvm.example.com
ALLOWED_ORIGINS=

# Nombre de reverse proxies de confiance devant l'application (Nginx = 1).
TRUST_PROXY=1

# Scraping et cache
SOURCE_URL=https://www.brvm.org/fr/cours-actions/0
CACHE_TTL_MS=1800000
CACHE_MAX_STALE_MS=86400000
SCRAPE_TIMEOUT_MS=10000
SCRAPE_RETRIES=2

# Fréquentation (aucune IP brute n'est stockée)
VISITS_RETENTION_DAYS=90

# Limites de débit (fenêtre par défaut : 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_API=60
# RATE_LIMIT_API_KEY=600
# RATE_LIMIT_VISITS=120
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_ADMIN=240
